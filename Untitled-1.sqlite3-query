CREATE TABLE Farm (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    layout TEXT,
    specialty TEXT,
    difficulty TEXT,
    pros TEXT,
    cons TEXT
);

CREATE TABLE planting (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    Seed TEXT,
    season TEXT,
    Growth time TEXT,
    Detail TEXT
);

CREATE TABLE items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    Function TEXT,
    Source TEXT,
    Location TEXT,
    How_to_get TEXT
);

CREATE TABLE NPC (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT,
    Birthday TEXT,
    Address TEXT,
    loves TEXT,
    Hates TEXT
    
);

CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE,
    password TEXT
    
);